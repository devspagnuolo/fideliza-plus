{
  "name": "fideliza-plus",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @fideliza/api\" \"npm run dev -w @fideliza/web\"",
    "build": "npm run build -w @fideliza/api && npm run build -w @fideliza/web",
    "test": "npm run test -w @fideliza/api",
    "db:migrate": "npm run db:migrate -w @fideliza/api",
    "db:seed": "npm run db:seed -w @fideliza/api",
    "db:backup": "npm run db:backup -w @fideliza/api",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": { "concurrently": "^9.1.2" },
  "engines": { "node": ">=20" }
}
